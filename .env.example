# ─────────────────────────────────────────────────────────────────────────────
# 4 BRO — environment variables
#
# Copy to .env.local for local development:   cp .env.example .env.local
# In production, set these in the hosting/deployment environment.
#
# NEVER commit real values. NEVER prefix secrets with NEXT_PUBLIC_ — anything
# with that prefix is bundled into browser JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe for the browser) ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:3306/DATABASE   (URL-encode special characters in the password)
# Local development: DATABASE_URL="mysql://root:4bro@localhost:3306/4bro" (kept in .env)
# Append ?ssl=true for managed databases that require TLS.
DATABASE_URL=
# Optional pool size per server instance (default 10)
DATABASE_CONNECTION_LIMIT=
# Optional: only needed if the DB user cannot create the temporary database `prisma migrate dev` uses
SHADOW_DATABASE_URL=

# ── Currency ─────────────────────────────────────────────────────────────────
# Prices are stored in PKR. Optional USD display rate (USD per 1 PKR, e.g. 0.0036).
# Leave empty to show PKR only — no rate is ever assumed.
EXCHANGE_RATE_PKR_USD=

# ── Authentication ───────────────────────────────────────────────────────────
# At least 32 random characters. Generate with:  openssl rand -base64 48
# Rotating it signs everyone out.
AUTH_SECRET=

# ── Admin settings encryption ────────────────────────────────────────────────
# WhatsApp, SMTP, contact and notification settings can be managed in /admin/settings.
# Values saved there override the variables below; these remain the fallback.
# Credentials saved in the admin are encrypted (AES-256-GCM) with this key.
# 32 random bytes, base64 or 64 hex chars:  openssl rand -base64 32
# BACK IT UP: if it is lost, credentials saved in the admin must be re-entered.
SETTINGS_ENCRYPTION_KEY=
# Rotation: put the old key here and a new one above; re-save credentials, then remove.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# ── SMTP email ───────────────────────────────────────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and a Google
# "App password" (not the account password). Secrets — server only.
SMTP_HOST=
SMTP_PORT=
# "true" for implicit TLS. Defaults to true on port 465, STARTTLS otherwise.
SMTP_SECURE=
# Login user (alias: SMTP_USER)
SMTP_USERNAME=
# App password (alias: SMTP_PASS)
SMTP_PASSWORD=
# From address (alias: SMTP_FROM_EMAIL) and display name (default "4 BRO")
SMTP_SENDER_EMAIL=
SMTP_FROM_NAME=
# Inbox for admin order alerts (alias: ADMIN_EMAIL). Defaults to the from address.
ADMIN_NOTIFICATION_EMAIL=
# Optional master switch for notification emails (default true). Password resets are unaffected.
EMAIL_NOTIFICATIONS_ENABLED=

# ── WhatsApp (WAAPI) ─────────────────────────────────────────────────────────
# Origin (https://waapi.axorawebsolutions.com) or the full endpoint
# (…/api/v1/messages/text). Customer messages go WhatsApp-first with email fallback.
WAAPI_BASE_URL=
# API key, sent as "Authorization: Bearer …" (alias: WAAPI_API_KEY). Secret.
WAAPI_TOKEN=
WAAPI_SESSION_ID=
# Admin alerts. Digits only, with country code, no "+" — e.g. 923001234567
WAAPI_ADMIN_NUMBER=
# Optional master switch for WhatsApp notifications (default true)
WHATSAPP_NOTIFICATIONS_ENABLED=

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: regional upload API, e.g. https://api-eu.cloudinary.com (default: global)
CLOUDINARY_API_BASE_URL=

# ── Public storefront contact (shown to customers; not secrets) ───────────────
# WhatsApp number for the floating chat button. Defaults to WAAPI_ADMIN_NUMBER.
PUBLIC_WHATSAPP_NUMBER=
# Contact email shown in the footer. Defaults to SMTP_SENDER_EMAIL.
PUBLIC_CONTACT_EMAIL=
# Social profile URLs (https://…). Links only render when set.
PUBLIC_INSTAGRAM_URL=
PUBLIC_TIKTOK_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_YOUTUBE_URL=
# Optional: display name (default "4 BRO"), phone (digits with country code), address
BUSINESS_NAME=
PUBLIC_CONTACT_PHONE=
PUBLIC_BUSINESS_ADDRESS=

# ── Optional admin bootstrap for `npm run db:seed` (otherwise use `npm run admin:create`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# ── Payments (PayNow) ─────────────────────────────────────────────────────────
# Foundation only: PayNow stays unavailable at checkout until its API contract is
# implemented in src/lib/payments/paynow.js from the provider's documentation AND
# these are set. Secrets — server only, never NEXT_PUBLIC_.
PAYNOW_API_BASE_URL=
PAYNOW_API_KEY=
PAYNOW_SECRET=

# ── Delivery (PKR) ────────────────────────────────────────────────────────────
# Flat standard delivery fee within Pakistan. Leave empty and orders are placed
# with the delivery fee "to be confirmed" by the store (no amount is invented).
DELIVERY_FEE_PKR=
# Optional: free standard delivery from this subtotal.
FREE_DELIVERY_THRESHOLD_PKR=
